# Copy to .env and fill in. docker compose reads it automatically.

# Image tag: latest (main branch), a release such as 1.2.3, or sha-<commit>
LANPARTY_VERSION=latest

# Admin password for /admin (at least 12 characters)
ADMIN_PASSWORD=
# Password of the PostgreSQL user (only used inside the compose network)
POSTGRES_PASSWORD=

# Time zone of the event dates (containers run in UTC otherwise)
TIMEZONE=Europe/Berlin

# Where the app listens on the host. 127.0.0.1 = only a reverse proxy on this
# machine can reach it; 0.0.0.0 = reachable from the whole network.
BIND_ADDRESS=127.0.0.1
PORT=8000

# Behind an HTTPS reverse proxy: TRUSTED_PROXIES=1 and SESSION_COOKIE_SECURE=1
TRUSTED_PROXIES=0
SESSION_COOKIE_SECURE=0

# gunicorn worker processes
WEB_CONCURRENCY=4
