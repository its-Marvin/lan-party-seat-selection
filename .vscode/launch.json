{
    // Start: F5 / "Run and Debug" → Konfiguration auswählen.
    // Voraussetzung: .venv mit `python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt`
    "version": "0.2.0",
    "configurations": [
        {
            "name": "LAN Party: Server starten (http://127.0.0.1:5000)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "args": [
                "--app", "lanparty:create_app",
                "run",
                "--host", "127.0.0.1",
                "--port", "5000",
                "--no-debugger",
                "--no-reload"
            ],
            "env": {
                "FLASK_DEBUG": "1",
                "ADMIN_PASSWORD": "admin",
                "ALLOW_WEAK_ADMIN_PASSWORD": "1",
                "DATABASE": "${workspaceFolder}/instance/dev.sqlite3"
            },
            "console": "integratedTerminal",
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "LAN Party: Tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "args": ["-v"],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
